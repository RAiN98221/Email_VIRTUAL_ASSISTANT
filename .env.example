# Mail provider: brevo | smtp
MAIL_PROVIDER=brevo

# --- Brevo SMTP relay (recommended) ---
# Generate an SMTP key (NOT an API key) at https://app.brevo.com/settings/keys/smtp
# Authenticate your domain and create a verified sender first.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
FROM_EMAIL=you@your-authenticated-domain.com
FROM_NAME=Your Name

# Optional: force a different connect host (leave blank normally)
SMTP_CONNECT_HOST=

APP_DATABASE_PATH=email_assistant.sqlite3
DEFAULT_CSV_PATH=filtered_contacts_under35_male_FIXED.csv
